{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ES2020",
    "lib": [
      "DOM",
      "ES2019"
    ],
    "sourceMap": true,
    "noImplicitAny": true,
    "importHelpers": true,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "survey-pdf": [
        "./src/doc_controller.ts"
      ]
    },
  },
  "include": [
    "src/entries/pdf.ts",
    "src/entries/pdf-node.ts",
    "src/fonts.ts"
  ]
}